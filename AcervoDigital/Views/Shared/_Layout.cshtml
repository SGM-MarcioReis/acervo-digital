<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Acervo Digital</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="topbar">
        <div class="container navbar">
            <a asp-controller="Home" asp-action="Index" class="brand">
                <span class="brand-mark">A</span>
                <div>
                    <strong>Acervo Digital</strong>
                    <small>Acervo da banda</small>
                </div>
            </a>

            <nav class="nav" aria-label="Navegação principal">
                <a asp-controller="Home" asp-action="Index">Início</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="acervo">Acervo</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="relatorio">Relatório</a>
                <a asp-controller="Admin" asp-action="Login">Admin</a>
            </nav>
        </div>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container footer-inner">
            <div>
                <strong>Acervo Digital</strong>
                <p>Registro visual e textual da banda.</p>
            </div>
            <a asp-controller="Admin" asp-action="Login" class="button secondary">Entrar</a>
        </div>
        <div class="footer-bottom">
            <span>© <span id="year"></span> Acervo Digital</span>
        </div>
    </footer>

    <script src="~/js/site.js" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
