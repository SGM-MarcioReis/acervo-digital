@model AcervoDigital.Models.ImagemEditViewModel

@{
    ViewData["Title"] = "Editar imagem";
}

<div class="form-container">
    <div class="section-title-row">
        <h1>Editar imagem</h1>
        <a asp-action="Dashboard" class="btn btn-secondary">Voltar</a>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Titulo">Título</label>
            <input asp-for="Titulo" class="form-control" />
            <span asp-validation-for="Titulo" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Categoria">Categoria</label>
            <select asp-for="Categoria" class="form-control">
                <option value="Programa">Programa</option>
                <option value="Ação">Ação</option>
                <option value="Impacto">Impacto</option>
                <option value="Geral">Geral</option>
            </select>
            <span asp-validation-for="Categoria" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Descricao">Descrição</label>
            <textarea asp-for="Descricao" rows="4" class="form-control"></textarea>
            <span asp-validation-for="Descricao" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Imagem atual</label>
            @if (!string.IsNullOrWhiteSpace(Model.ImagemAtual))
            {
                <img src="@Model.ImagemAtual" alt="Imagem atual" class="edit-preview" />
            }
        </div>

        <div class="form-group">
            <label asp-for="Foto">Trocar imagem</label>
            <input asp-for="Foto" type="file" accept="image/*" class="form-control" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Salvar alterações</button>
            <a asp-action="Dashboard" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
