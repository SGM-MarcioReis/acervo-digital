@model AcervoDigital.Models.AdminChangePasswordViewModel

@{
    ViewData["Title"] = "Alterar senha";
}

<div class="form-container">
    <div class="section-title-row">
        <h1>Alterar senha</h1>
        <a asp-action="Dashboard" class="btn btn-secondary">Voltar</a>
    </div>

    <form asp-action="ChangePassword" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="CurrentPassword">Senha atual</label>
            <input asp-for="CurrentPassword" type="password" class="form-control" />
            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="NewPassword">Nova senha</label>
            <input asp-for="NewPassword" type="password" class="form-control" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword">Confirmar nova senha</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Salvar nova senha</button>
            <a asp-action="Dashboard" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
