@model AcervoDigital.Models.ImagemCreateViewModel

@{
    ViewData["Title"] = "Nova imagem";
}

<div class="form-container">
    <h1>Adicionar imagem</h1>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Titulo">Título</label>
            <input asp-for="Titulo" class="form-control" />
            <span asp-validation-for="Titulo" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Categoria">Categoria</label>
            <select asp-for="Categoria" class="form-control">
                <option value="Programa">Programa</option>
                <option value="Ação">Ação</option>
                <option value="Impacto">Impacto</option>
                <option value="Geral">Geral</option>
            </select>
            <span asp-validation-for="Categoria" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Descricao">Descrição</label>
            <textarea asp-for="Descricao" rows="4" class="form-control"></textarea>
            <span asp-validation-for="Descricao" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Foto">Imagem</label>
            <input asp-for="Foto" type="file" accept="image/*" class="form-control" />
            <span asp-validation-for="Foto" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Salvar imagem</button>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
