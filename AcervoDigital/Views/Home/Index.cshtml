@model IEnumerable<AcervoDigital.Models.Imagem>

@{
    ViewData["Title"] = "Acervo da banda";
}

@{
    var destaques = Model
        .Where(x => x.PosicaoHome > 0)
        .OrderBy(x => x.PosicaoHome)
        .Take(2)
        .ToList();

    var destaquePrincipal = destaques.FirstOrDefault(x => x.PosicaoHome == 1)
        ?? destaques.FirstOrDefault();

    var destaqueSecundario = destaques.FirstOrDefault(x => x.PosicaoHome == 2)
        ?? destaques.Skip(1).FirstOrDefault();
}

<section class="hero">
    <div class="container hero-grid">
        <div class="hero-copy">
            <span class="eyebrow">Arquivo visual da banda</span>
            <h1>Acervo digital para registrar a história da banda.</h1>
            <p>
                Fotos, shows, ensaios, eventos e bastidores organizados em um acervo profissional,
                prontos para inspirar a montagem de apresentações e relatórios do ano.
            </p>

            <div class="hero-actions">
                <a asp-controller="Admin" asp-action="Login" class="button primary">Adicionar imagem</a>
                <a href="#acervo" class="button secondary">Ver acervo</a>
            </div>

            <ul class="stats" aria-label="Estatísticas do projeto">
                <li>
                    <strong>@(Model?.Count() ?? 0)</strong>
                    <span>Registros</span>
                </li>
                <li>
                    <strong>@(Model.Select(x => x.Ano).Distinct().Count())</strong>
                    <span>Anos</span>
                </li>
                <li>
                    <strong>@(Model.Count(x => x.Categoria == "Show"))</strong>
                    <span>Shows</span>
                </li>
            </ul>
        </div>

        <div class="hero-visual" aria-label="Imagem ilustrativa da banda">
            <div class="visual-card main">
                <img src="@(destaquePrincipal != null ? destaquePrincipal.CaminhoArquivo : "https://images.unsplash.com/photo-1501386761578-eac5c8dd5006?auto=format&fit=crop&w=900&q=80")"
                     alt="@(destaquePrincipal != null ? destaquePrincipal.Titulo : "Banda em apresentação")" />
            </div>
            <div class="visual-card floating">
                <img src="@(destaqueSecundario != null ? destaqueSecundario.CaminhoArquivo : "https://images.unsplash.com/photo-1501612780327-45045538702b?auto=format&fit=crop&w=700&q=80")"
                     alt="@(destaqueSecundario != null ? destaqueSecundario.Titulo : "Banda em ensaio")" />
            </div>
        </div>
    </div>
</section>

<section id="acervo" class="gallery-section">
    <div class="container">
        <div class="section-head">
            <div>
                <span class="eyebrow">Acervo</span>
                <h2>Registro fotográfico da banda</h2>
            </div>
            <p>
                Cada imagem guarda o momento, o local, o ano e a história por trás da performance.
            </p>
        </div>

        <div class="filters" aria-label="Filtros de categoria">
            <button class="filter active" type="button" data-filter="all">Todos</button>
            <button class="filter" type="button" data-filter="show">Show</button>
            <button class="filter" type="button" data-filter="ensaio">Ensaio</button>
            <button class="filter" type="button" data-filter="evento">Evento</button>
            <button class="filter" type="button" data-filter="divulgação">Divulgação</button>
            <button class="filter" type="button" data-filter="backstage">Backstage</button>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <h2>Nenhuma imagem cadastrada ainda</h2>
                <p>Comece adicionando fotos da banda para compor o acervo.</p>
            </div>
        }
        else
        {
            <div class="gallery-grid">
                @foreach (var imagem in Model)
                {
                    <article class="card" data-category="@imagem.Categoria.ToLowerInvariant()">
                        <a href="@imagem.CaminhoArquivo"
                           class="image-open"
                           data-image="@imagem.CaminhoArquivo"
                           data-title="@imagem.Titulo"
                           data-description="@(!string.IsNullOrWhiteSpace(imagem.Descricao) ? imagem.Descricao : "Sem descrição disponível.")">
                            <img src="@imagem.CaminhoArquivo" alt="@imagem.Titulo" />
                        </a>

                        <div class="card-body">
                            <span class="tag">@imagem.Categoria</span>
                            <h3>@imagem.Titulo</h3>
                            <p><strong>Data:</strong> @imagem.DataEvento.ToString("dd/MM/yyyy")</p>
                            <p><strong>Local:</strong> @imagem.Local</p>
                            @if (!string.IsNullOrWhiteSpace(imagem.Descricao))
                            {
                                <p>@imagem.Descricao</p>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

<div class="image-modal" id="imageModal" aria-hidden="true">
    <div class="image-modal-content">
        <button type="button" class="image-modal-close" aria-label="Fechar">×</button>
        <img class="image-modal-image" src="" alt="Imagem ampliada" />
        <div class="image-modal-body">
            <h3 class="image-modal-title"></h3>
            <p class="image-modal-description"></p>
        </div>
    </div>
</div>
